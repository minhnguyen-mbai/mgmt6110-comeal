# Copy this file to .env.local and fill in real values.
# .env* is gitignored (except this example) - never commit real credentials.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────────────────────
# OneMap Singapore (address search + walking routing)
#
# Register a free account at https://www.onemap.gov.sg/apidocs/ and use those
# account credentials here. The server exchanges them for a short-lived access
# token (~3 days) via POST /api/auth/post/getToken and refreshes it as needed.
#
# SERVER-SIDE ONLY. These must never be exposed to the browser: do not rename
# them to VITE_* and do not reference them from anything under src/.
#
# Without these, address search and walking distance are unavailable and the UI
# shows "Distance unavailable". Nothing else in the app is affected.
# ─────────────────────────────────────────────────────────────────────────────
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
